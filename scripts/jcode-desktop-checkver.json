{
    "github": "https://api.github.com/repos/1jehuang/jcode-desktop/releases?per_page=100",
    "script": [
        "if (!$page -or !$page.TrimStart().StartsWith('[')) { throw 'Expected a Jcode Desktop release list.' }",
        "$releases = $page | ConvertFrom-Json -ErrorAction Stop",
        "foreach ($release in @($releases | Sort-Object -Property published_at -Descending)) {",
        "    if ($release.draft -ne $false -or !$release.published_at) { continue }",
        "    $tag = [regex]::Match([string]$release.tag_name, '^desktop-v(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)$')",
        "    if (!$tag.Success) { continue }",
        "    $version = $tag.Groups[1].Value",
        "    $required = @(\"Jcode-$version-windows-x86_64.zip\", \"Jcode-$version-windows-aarch64.zip\", 'SHA256SUMS-windows', 'SHA256SUMS-windows-aarch64')",
        "    $ready = @($release.assets | Where-Object { $_.state -ceq 'uploaded' -and $_.size -gt 0 } | ForEach-Object { $_.name })",
        "    if (@($required | Where-Object { $ready -cnotcontains $_ }).Count -eq 0) { return $version }",
        "}",
        "throw 'No published Jcode Desktop release has all required Windows assets.'"
    ],
    "regex": "^(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)$"
}
