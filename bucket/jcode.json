{
    "version": "1.0.3",
    "description": "High-performance AI coding agent harness written in Rust for multi-agent development workflows.",
    "homepage": "https://github.com/1jehuang/jcode",
    "license": "MIT",
    "notes": [
        "Automatic self-update checks are disabled with JCODE_NO_AUTO_UPDATE=1. Use 'scoop update jcode' instead of 'jcode update'.",
        "Credentials and configuration remain in the upstream default ~/.jcode directory, or your JCODE_HOME override.",
        "Provider authentication and model access must be configured separately. This package does not run the upstream installer."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/1jehuang/jcode/releases/download/v1.0.3/jcode-windows-x86_64.tar.gz",
            "hash": "de40f140d0d91902df1ed0e885bbdd8532bcaba49157afe5d69c875677f2877d",
            "bin": [
                [
                    "jcode-windows-x86_64.exe",
                    "jcode"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/1jehuang/jcode/releases/download/v1.0.3/jcode-windows-aarch64.tar.gz",
            "hash": "99f2f91eb5e9af129deee50d3919e2f508898dd05a4a51981c149caa96364674",
            "bin": [
                [
                    "jcode-windows-aarch64.exe",
                    "jcode"
                ]
            ]
        }
    },
    "env_set": {
        "JCODE_NO_AUTO_UPDATE": "1"
    },
    "checkver": {
        "github": "https://api.github.com/repos/1jehuang/jcode/releases?per_page=100",
        "script": [
            "if (!$page -or !$page.TrimStart().StartsWith('[')) { throw 'Expected a Jcode release list.' }",
            "$releases = $page | ConvertFrom-Json -ErrorAction Stop",
            "$required = @('jcode-windows-x86_64.tar.gz', 'jcode-windows-aarch64.tar.gz', 'SHA256SUMS')",
            "$best = $json.version",
            "foreach ($release in $releases) {",
            "    if ($release.draft -ne $false -or $release.prerelease -ne $false -or !$release.published_at) { continue }",
            "    $tag = [regex]::Match([string]$release.tag_name, '^v([0-9]+\\.[0-9]+\\.[0-9]+)$')",
            "    if (!$tag.Success) { continue }",
            "    $version = $tag.Groups[1].Value",
            "    if ([version]$version -le [version]$best) { continue }",
            "    $ready = @($release.assets | Where-Object { $_.state -ceq 'uploaded' -and $_.size -gt 0 } | ForEach-Object { $_.name })",
            "    if (@($required | Where-Object { $ready -cnotcontains $_ }).Count -eq 0) { $best = $version }",
            "}",
            "return $best"
        ],
        "regex": "^([0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/1jehuang/jcode/releases/download/v$version/jcode-windows-x86_64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/1jehuang/jcode/releases/download/v$version/jcode-windows-aarch64.tar.gz"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
