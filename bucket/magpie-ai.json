        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.3217/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "52ce58d43f2d227ccdc57a2b75255ea269e3836ff9b1f4edcca42ef685993ac2"
