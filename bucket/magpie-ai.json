        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.2726/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "66ec026e01242ab70ab6e3f440972848d3e3ea31166d9eac805d5e959baa440c"
