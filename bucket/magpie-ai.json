{
    "version": "0.1.1648",
    "description": "Unified model, provider, and gateway manager for AI coding agents.",
    "homepage": "https://usemagpie.ai",
    "license": "MIT",
    "notes": [
        "Scoop persists data since version 0.1.1067. You may need to move data by yourself.",
        "Before: '$env:USERPROFILE\\.config\\magpie'",
        "After : '$persist_dir\\data'"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1648/magpie-windows-amd64.exe#/magpie.exe",
            "hash": "32b1042ba40320f39b93cea183db324bfeced0655aded85520a472e79fe18742"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1648/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "98c1ccd8e74cd12127963b6624c57ce4d30e5cd077d42e58610bebf1298e2937"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-windows-amd64.exe#/magpie.exe"
            },
            "arm64": {
                "url": "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-windows-arm64.exe#/magpie.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
