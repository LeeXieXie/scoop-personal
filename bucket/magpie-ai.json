        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1969/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "f6a179b7cb1b657bdf2ac4b3934638fc6e373e071b2f703df69d5a706f68759f"
        }
