{
    "version": "3.16.2.20261020062305-upstream.3c5b22764937",
    "description": "Unofficial ZCode AI coding workspace community build with verified bundled plugin assets.",
    "homepage": "https://github.com/LeeXieXie/zcode-releases",
    "license": "Apache-2.0",
    "notes": [
        "Unofficial, unsigned community build; Computer Use is not available.",
        "Upstream records unresolved third-party license-material gaps. Review the release notices before use.",
        "User data remains in the upstream default locations; this manifest does not move or delete existing data.",
        "Application auto-updates are disabled in this build. Use 'scoop update zcode'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/LeeXieXie/zcode-releases/releases/download/v3.16.2-upstream.3c5b22764937/ZCode-3.16.2-win-x64.exe#/dl.7z",
            "hash": "441d65585aaad2ec72fdc3841a2af405ef0eed63d79470650466ece06045fb19"
        }
    },
    "installer": {
        "script": [
            "$payload = @(Get-ChildItem -LiteralPath (Join-Path $dir '$PLUGINSDIR') -Filter 'app-64.7z' -File)",
            "if ($payload.Count -ne 1) { throw 'Expected exactly one x64 NSIS application payload.' }",
            "$payload[0] | Expand-7zipArchive -DestinationPath $dir -Removal",
            "if (!(Test-Path -LiteralPath (Join-Path $dir 'ZCode.exe') -PathType Leaf)) { throw 'ZCode.exe missing after extraction.' }",
            "$root = [IO.Path]::GetFullPath($dir).TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar",
            "foreach ($name in @('$PLUGINSDIR', '$R0', 'Uninstall ZCode.exe')) {",
            "    $target = [IO.Path]::GetFullPath((Join-Path $dir $name))",
            "    if (!$target.StartsWith($root, [StringComparison]::OrdinalIgnoreCase)) { throw 'Unsafe installer cleanup path.' }",
            "    if (Test-Path -LiteralPath $target) { Remove-Item -LiteralPath $target -Recurse -Force }",
            "}"
        ]
    },
    "shortcuts": [
        [
            "ZCode.exe",
            "ZCode (Community)"
        ]
    ],
    "checkver": {
        "url": "https://github.com/LeeXieXie/zcode-releases/releases/latest/download/build-provenance.json",
        "script": [
            "$release = $page | ConvertFrom-Json",
            "if ($release.upstream.repository -ne \"zai-org/ZCode\" -or $release.upstream.sha -notmatch \"^[a-f0-9]{40}$\" -or $release.upstream.version -notmatch \"^\\d+\\.\\d+\\.\\d+$\") { throw \"Invalid ZCode release provenance.\" }",
            "$stamp = ([DateTimeOffset]::Parse($release.upstream.date)).UtcDateTime.ToString(\"yyyyMMddHHmmss\")",
            "\"$($release.upstream.version).$stamp-upstream.$($release.upstream.sha.Substring(0, 12))\""
        ],
        "regex": "^((?<appversion>\\d+\\.\\d+\\.\\d+)\\.\\d{14}-upstream\\.(?<commit>[a-f0-9]{12}))$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LeeXieXie/zcode-releases/releases/download/v$matchAppversion-upstream.$matchCommit/ZCode-$matchAppversion-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
